{
  "expo": {
    "name": "Iron Log",
    "slug": "iron-log",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ironlog",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0c0b",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0c0b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.foldyfamily.ironlog",
      "buildNumber": "1",
      "infoPlist": {
        "UIUserInterfaceStyle": "Dark",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.foldyfamily.ironlog",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0c0b"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://api-omega-dun-72.vercel.app"
    }
  }
}
