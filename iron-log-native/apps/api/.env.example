# Iron Log API environment. Copy to .env.local for local dev; on Vercel set
# these in Project → Settings → Environment Variables.

# Postgres connection string. On Vercel, add a Postgres/Neon store and this is
# injected automatically as POSTGRES_URL.
POSTGRES_URL=

# Long random string used to sign session JWTs (e.g. `openssl rand -hex 32`).
AUTH_SECRET=
